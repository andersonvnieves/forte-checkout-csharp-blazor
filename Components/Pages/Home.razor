@page "/"

<PageTitle>CSG Forte - FCO Blazor Integration (Demo)</PageTitle>

<section class="fco-section">
    <div class="fco-hero-left">
        <div class="fco-hero-left-inner">
            <h1 class="fco-h1">With Forte Checkout<br class="fco-br-sm" /> you can sell anything</h1>
            <h1 class="fco-h1-bold">Even a piece of the moon</h1>
            <div class="fco-cta-stack">
                <a href="/automaticdemo" class="fco-btn-primary">Test Now (auto)</a>
                <a href="/clickdemo" class="fco-btn-primary">Test Now (click)</a>
                <a href="/modaldemo" class="fco-btn-primary">Test Now (modal)</a>
            </div>
        </div>

        <p class="fco-tagline">Unfortunately this is just a tech demo and we are<br class="fco-br-lg" /> not able to sell you a real piece of the moon.</p>
    </div>

    <div class="fco-hero-right fco-hero-right--image">
        <img src="assets/astronaut.png" alt="Astronaut" class="fco-astronaut" />
    </div>
</section>
